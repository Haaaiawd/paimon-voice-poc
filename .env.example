# Fish Audio — https://fish.audio/app/api-keys
# 免费层模型串固定为 s2.1-pro-free（付费模型需充 API credit，会 402）
fish_audio_api_key=

# 阿里云百炼 DashScope — https://bailian.console.aliyun.com/
# 一把 key 覆盖：paraformer-realtime-v2（ASR）、qwen-*（LLM）、cosyvoice-v3-flash / qwen-audio-3.0-tts-flash（TTS）
# 注意：cosyvoice-v3.5-flash 在本账号返回 418（未开通/不支持），用 v3-flash
dashscope_api_key=

# LLM 备选：DeepSeek（OpenAI-compatible），有则启用赛马
deepseek_api_key=

# 网络注意：本机代理(127.0.0.1:55483)会给每次连接 +~1.9s TLS 开销。
# 语音闭环需对 dashscope.aliyuncs.com / api.fish.audio 走直连（绕过代理）。
