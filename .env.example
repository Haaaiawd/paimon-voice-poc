# Fish Audio — https://fish.audio/app/api-keys
# 免费层模型串固定为 s2.1-pro-free（付费模型需充 API credit，会 402）
FISH_API_KEY=

# 阿里云百炼 DashScope — https://bailian.console.aliyun.com/
# 一把 key 覆盖：paraformer-realtime-v2（ASR）、qwen3.7-flash（LLM，优先）、cosyvoice-v3-flash / qwen-audio-3.0-tts-flash（TTS）
# 注意：cosyvoice-v3.5-flash 在本账号返回 418（未开通/不支持），用 v3-flash
DASHSCOPE_API_KEY=

# LLM 备选：DeepSeek（OpenAI-compatible），有则启用赛马
DEEPSEEK_API_KEY=

# 百炼工作区级凭证（可选；业务空间隔离计费/配额时用，与全局 key 互不通用）
# 注意：工作区 key 只认工作区端点，且需在控制台给该空间开模型权限
# DASHSCOPE_WS_ID=
# DASHSCOPE_WS_API_KEY=
# DASHSCOPE_WS_API_HOST=          # ws-xxx.cn-beijing.maas.aliyuncs.com
# DASHSCOPE_WS_OPENAI_URL=        # https://{API_HOST}/compatible-mode/v1
# DASHSCOPE_WS_API_URL=           # https://{API_HOST}/api/v1

# 可选：覆盖 ASR/TTS 的 WebSocket 端点（relay/私有网关；默认官方 api-ws）
# DASHSCOPE_WS_URL=               # wss://dashscope.aliyuncs.com/api-ws/v1/inference

# 网络注意：本机 Clash 代理(127.0.0.1:55483)会给每次连接 +~1.9s TLS 开销。
# 推荐在 Clash 规则里把以下域名设为 DIRECT：
#   dashscope.aliyuncs.com、*.aliyuncs.com（百炼全家桶）、api.fish.audio
# 或代码层绕过：httpx trust_env=False / websocket 库显式禁用 env proxy。

# WS Gateway（TASK-017，前端 demo 阶段 2）：python -m runtime.ws_gateway
# 前端走 vite dev proxy（/ws → 本端口），默认无需改动。
WS_GATEWAY_HOST=127.0.0.1
WS_GATEWAY_PORT=8765
WS_GATEWAY_CORS_ORIGINS=http://localhost:5173
